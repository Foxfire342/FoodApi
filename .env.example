# Local development only — on Vercel, set these in Project Settings → Environment Variables.

# Required
USDA_API_KEY=your_api_key_here

# Optional
PORT=3000
USDA_REQUEST_TIMEOUT_MS=15000

# Global rate limit (all routes except /health)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Stricter limit for /foods searches
FOODS_RATE_LIMIT_WINDOW_MS=60000
FOODS_RATE_LIMIT_MAX=20
